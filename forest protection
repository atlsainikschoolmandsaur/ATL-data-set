#include <SPI.h>
#include <SD.h>
#include <DHT.h>

// --- PIN DEFINITIONS ---
#define SD_CS_PIN       4   // SD Card Chip Select
#define LASER_PIN       5   // Laser Output Pin
#define TRIG_PIN        6   // Ultrasonic Trigger Pin
#define ECHO_PIN        7   // Ultrasonic Echo Pin
#define LDR_PIN         8   // LDR Sensor Pin
#define SOUND_PIN       9   // Digital Sound Detector Pin
#define PIR_PIN        10   // PIR Motion Sensor Pin
#define FLAME_PIN      11   // Flame Sensor Pin
#define DHT_PIN        12   // DHT Temperature Sensor Pin
#define MQ2_PIN        A0   // MQ2 Gas Sensor Pin
#define MIC_ANALOG_PIN A1   // Analog Microphone Input for Sound Recording
#define BUZZER_PIN     3    // Active Alarm Buzzer Pin

// --- CONFIGURATION THRESHOLDS ---
const int WARNING_DISTANCE_CM = 30; // Buzzer sounds when object is within 30cm

#define DHTTYPE DHT22
DHT dht(DHT_PIN, DHTTYPE);

// Audio recording variables
bool isRecording = false;
File audioFile;
unsigned long recordStartTime = 0;
int fileCounter = 1;

void setup() {
  Serial.begin(9600);
  
  pinMode(LASER_PIN, OUTPUT);
  digitalWrite(LASER_PIN, HIGH); // Turn on laser tripwire beam
  
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(LDR_PIN, INPUT);
  pinMode(SOUND_PIN, INPUT);
  pinMode(PIR_PIN, INPUT);
  pinMode(FLAME_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  dht.begin();

  // Initialize SD Card Module
  if (!SD.begin(SD_CS_PIN)) {
    // SD Card module uninitialized or missing
  }
}

void loop() {
  // Check for incoming commands from Web Serial Dashboard
  if (Serial.available() > 0) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    handleIncomingCommand(cmd);
  }

  // Sample analog microphone input to SD card when recording
  if (isRecording) {
    sampleAndRecordAudio();
    if (millis() - recordStartTime >= 5000) { // 5-second default limit
      stopRecordingAudio();
    }
    return; 
  }

  // Send Sensor Telemetry Stream every 500ms
  static unsigned long lastStreamTime = 0;
  if (millis() - lastStreamTime >= 500) {
    lastStreamTime = millis();
    sendTelemetry();
  }
}

void sendTelemetry() {
  bool ldrBroken = (digitalRead(LDR_PIN) == LOW);
  bool soundDetected = (digitalRead(SOUND_PIN) == HIGH);
  bool pirMotion = (digitalRead(PIR_PIN) == HIGH);
  bool flameDetected = (digitalRead(FLAME_PIN) == LOW);
  int gasVal = analogRead(MQ2_PIN);

  // Ultrasonic Distance Measurement
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  long duration = pulseIn(ECHO_PIN, HIGH, 20000);
  int distanceCm = (duration == 0) ? 999 : (duration * 0.034 / 2);

  // --- INTEGRATED AUTOMATIC BUZZER CONTROL ---
  // If an object comes closer than WARNING_DISTANCE_CM, activate the buzzer
  if (distanceCm > 0 && distanceCm <= WARNING_DISTANCE_CM) {
    digitalWrite(BUZZER_PIN, HIGH); 
  } else if (!isRecording) { 
    // Turn buzzer off if path is clear (and not actively playing back audio)
    digitalWrite(BUZZER_PIN, LOW);  
  }

  float tempC = dht.readTemperature();
  if (isnan(tempC)) tempC = 0.0;

  // Format line: LDR: OK | Sound: CLEAR | PIR: CLEAR | Flame: CLEAR | Gas: 120 | Dist: 15cm | Temp: 26.5C
  String dataLine = "";
  dataLine += "LDR: " + String(ldrBroken ? "BROKEN" : "OK") + " | ";
  dataLine += "Sound: " + String(soundDetected ? "DETECTED" : "CLEAR") + " | ";
  dataLine += "PIR: " + String(pirMotion ? "MOTION!" : "CLEAR") + " | ";
  dataLine += "Flame: " + String(flameDetected ? "FIRE!" : "CLEAR") + " | ";
  dataLine += "Gas: " + String(gasVal) + " | ";
  dataLine += "Dist: " + String(distanceCm) + "cm | ";
  dataLine += "Temp: " + String(tempC, 1) + "C | ";
  dataLine += "Lat: 12.9716 | Lng: 77.5946"; // Connect NEO-6M GPS variables here

  Serial.println(dataLine);
}

void handleIncomingCommand(String cmd) {
  if (cmd == "START_RECORDING") {
    startRecordingAudio();
  } else if (cmd == "STOP_RECORDING") {
    stopRecordingAudio();
  } else if (cmd == "GET_AUDIO_FILES") {
    listSdSoundFiles();
  } else if (cmd.startsWith("PLAY_AUDIO:")) {
    String filename = cmd.substring(11);
    playbackAudioFile(filename);
  } else if (cmd.startsWith("DELETE_AUDIO:")) {
    String filename = cmd.substring(13);
    if (SD.exists(filename)) {
      SD.remove(filename);
      Serial.println("ALERT: Deleted file " + filename);
    }
    listSdSoundFiles();
  }
}

void startRecordingAudio() {
  String fileName = "REC_" + String(fileCounter++) + ".RAW";
  audioFile = SD.open(fileName, FILE_WRITE);
  if (audioFile) {
    isRecording = true;
    recordStartTime = millis();
    Serial.println("ALERT: Recording started: " + fileName);
  } else {
    Serial.println("ALERT: SD Card writing failed!");
  }
}

void sampleAndRecordAudio() {
  if (audioFile) {
    int micVal = analogRead(MIC_ANALOG_PIN);
    audioFile.write((uint8_t)(micVal >> 2)); // Convert 10-bit analog to 8-bit PCM byte
  }
}

void stopRecordingAudio() {
  if (isRecording && audioFile) {
    audioFile.close();
    isRecording = false;
    Serial.println("ALERT: Recording saved successfully.");
    listSdSoundFiles();
  }
}

void listSdSoundFiles() {
  File root = SD.open("/");
  while (true) {
    File entry = root.openNextFile();
    if (!entry) break;
    if (!entry.isDirectory()) {
      String name = String(entry.name());
      if (name.endsWith(".RAW") || name.endsWith(".WAV")) {
        // Output format: FILE:<filename>:<size>
        Serial.println("FILE:" + name + ":" + String(entry.size()) + " B");
      }
    }
    entry.close();
  }
  root.close();
}

void playbackAudioFile(String filename) {
  if (SD.exists(filename)) {
    File playFile = SD.open(filename);
    Serial.println("ALERT: Playing back sound file " + filename);
    while (playFile.available()) {
      uint8_t sample = playFile.read();
      analogWrite(BUZZER_PIN, sample); // Output raw audio byte stream to buzzer pin
      delayMicroseconds(125); // ~8kHz playback rate
    }
    playFile.close();
    analogWrite(BUZZER_PIN, 0);
    Serial.println("ALERT: Playback finished.");
  }
}
